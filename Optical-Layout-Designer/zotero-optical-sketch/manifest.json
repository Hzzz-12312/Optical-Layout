{
  "manifest_version": 2,
  "name": "光路手绘 · Optical Sketch",
  "description": "在 Zotero 条目面板中手动绘制光路，按 PDF 附件保存在本机，并可导出 Optical Layout Designer 原理图。",
  "version": "0.1.2",
  "author": "Hzzz-12312",
  "homepage_url": "https://github.com/Hzzz-12312/Optical-Layout",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "optical-sketch@local.tools",
      "update_url": "https://raw.githubusercontent.com/Hzzz-12312/Optical-Layout/main/Optical-Layout-Designer/zotero-optical-sketch/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
